rules_version = '2';
// Lernbik. Everyone signs in anonymously. A user's data lives under a random
// 16-character key (the recovery code), so it can be read only by someone who knows it.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function small() { return request.resource.size() < 900000; }

    // Private user data: nick, group, done marks, reminder times, push tokens.
    match /users/{key} {
      allow get, create, update: if signedIn() && key.size() == 16;
    }
    // Name → account. The same name always opens the same account; names are never reassigned.
    match /nicks/{n} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.key is string && request.resource.data.key.size() == 16;
    }
    // Wortkreis progress (written by the Wortkreis page).
    match /wk/{key} {
      allow get, create, update: if signedIn() && key.size() == 16 && small();
    }

    match /groups/{gid} {
      // Everyone sees the list of groups on the first start and can join any of them.
      allow get, list: if signedIn();
      // The old course group "vhs-lueneburg" was closed (everyone moved to "VHS Lüneburg 277"); old app versions
      // must not bring it back.
      allow create: if signedIn() && gid != 'vhs-lueneburg' && request.resource.data.keys().hasOnly(['name', 'created', 'examDate', 'examName', 'ownerMid', 'ownerNick', 'course', 'helpers'])
        && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 40;
      // course = the chapter the course is on now; helpers = who may move it (set in the app by admins).
      // Deleting is done by the main admin in the app (the app checks who; the rules can't, names aren't verified).
      allow delete: if signedIn();
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['examDate', 'examName', 'course', 'helpers'])
        && (!('course' in request.resource.data) || (request.resource.data.course.lv in ['A1', 'A2'] && request.resource.data.course.n is int))
        && (!('helpers' in request.resource.data) || (request.resource.data.helpers is list && request.resource.data.helpers.size() <= 20));

      // Homework: everyone can add and edit; deleting is a soft delete.
      match /hw/{id} {
        allow read: if signedIn();
        allow create, update: if signedIn() && gid != 'vhs-lueneburg' && request.resource.data.text is string && request.resource.data.text.size() < 2000;
        allow delete: if signedIn();
      }
      match /news/{id} {
        allow read: if signedIn();
        allow create, update: if signedIn() && gid != 'vhs-lueneburg' && request.resource.data.text is string && request.resource.data.text.size() < 500;
        allow delete: if signedIn();
      }
      // "Move to another group" notes from the main admin; the person's app follows and deletes it.
      match /moves/{mid} {
        allow read, delete: if signedIn();
        allow create, update: if signedIn() && request.resource.data.to is string && request.resource.data.to.size() < 40;
      }
      // Public stats per member: nick, word count, learned topics, streak.
      match /members/{mid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && gid != 'vhs-lueneburg';
        allow delete: if signedIn();
      }
    }

    // Mistake reports: anyone can send, nobody can read through the app.
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.text is string && request.resource.data.text.size() < 3000;
    }
  }
}
